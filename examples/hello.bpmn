<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sequent" exporterVersion="0.2.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="Process_hello" name="Hello" isExecutable="true">
    <bpmn:startEvent id="StartEvent_begin" name="Started">
      <bpmn:outgoing>Flow_begin_greet</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_greet" name="Say hello">
      <bpmn:incoming>Flow_begin_greet</bpmn:incoming>
      <bpmn:outgoing>Flow_greet_done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_done" name="Finished">
      <bpmn:incoming>Flow_greet_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_begin_greet" sourceRef="StartEvent_begin" targetRef="Activity_greet" />
    <bpmn:sequenceFlow id="Flow_greet_done" sourceRef="Activity_greet" targetRef="Event_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_hello">
      <bpmndi:BPMNShape id="StartEvent_begin_di" bpmnElement="StartEvent_begin">
        <dc:Bounds x="42" y="62" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="41" y="103" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_greet_di" bpmnElement="Activity_greet">
        <dc:Bounds x="140" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_done_di" bpmnElement="Event_done">
        <dc:Bounds x="302" y="62" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="298" y="103" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_begin_greet_di" bpmnElement="Flow_begin_greet">
        <di:waypoint x="78" y="80" />
        <di:waypoint x="140" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_greet_done_di" bpmnElement="Flow_greet_done">
        <di:waypoint x="240" y="80" />
        <di:waypoint x="302" y="80" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
