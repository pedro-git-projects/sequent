<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sequent" exporterVersion="0.2.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="Process_linear" name="Linear flow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_submitted">
      <bpmn:outgoing>Flow_submitted_validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_validate" name="Validate order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-validate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_submitted_validate</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_charge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_charge" name="Charge card">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment-charge" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_validate_charge</bpmn:incoming>
      <bpmn:outgoing>Flow_charge_done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_done">
      <bpmn:incoming>Flow_charge_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_submitted_validate" sourceRef="StartEvent_submitted" targetRef="Activity_validate" />
    <bpmn:sequenceFlow id="Flow_validate_charge" sourceRef="Activity_validate" targetRef="Activity_charge" />
    <bpmn:sequenceFlow id="Flow_charge_done" sourceRef="Activity_charge" targetRef="Event_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_linear">
      <bpmndi:BPMNShape id="StartEvent_submitted_di" bpmnElement="StartEvent_submitted">
        <dc:Bounds x="42" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_validate_di" bpmnElement="Activity_validate">
        <dc:Bounds x="140" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_charge_di" bpmnElement="Activity_charge">
        <dc:Bounds x="300" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_done_di" bpmnElement="Event_done">
        <dc:Bounds x="462" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_submitted_validate_di" bpmnElement="Flow_submitted_validate">
        <di:waypoint x="78" y="80" />
        <di:waypoint x="140" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_validate_charge_di" bpmnElement="Flow_validate_charge">
        <di:waypoint x="240" y="80" />
        <di:waypoint x="300" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_charge_done_di" bpmnElement="Flow_charge_done">
        <di:waypoint x="400" y="80" />
        <di:waypoint x="462" y="80" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
