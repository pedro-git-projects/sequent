<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sequent" exporterVersion="0.2.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="Process_rework" name="Rework loop" isExecutable="true">
    <bpmn:startEvent id="StartEvent_received" name="Draft received">
      <bpmn:outgoing>Flow_received_revise</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_revise" name="Revise the draft">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="=editors" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_received_revise</bpmn:incoming>
      <bpmn:incoming>Flow_accepted_revise</bpmn:incoming>
      <bpmn:outgoing>Flow_revise_check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_check" name="Run the checks">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="doc-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_revise_check</bpmn:incoming>
      <bpmn:outgoing>Flow_check_accepted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_accepted" name="Accepted?" default="Flow_accepted_published">
      <bpmn:incoming>Flow_check_accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_accepted_revise</bpmn:outgoing>
      <bpmn:outgoing>Flow_accepted_published</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_published" name="Published">
      <bpmn:incoming>Flow_accepted_published</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_received_revise" sourceRef="StartEvent_received" targetRef="Activity_revise" />
    <bpmn:sequenceFlow id="Flow_revise_check" sourceRef="Activity_revise" targetRef="Activity_check" />
    <bpmn:sequenceFlow id="Flow_check_accepted" sourceRef="Activity_check" targetRef="Gateway_accepted" />
    <bpmn:sequenceFlow id="Flow_accepted_revise" name="needs work" sourceRef="Gateway_accepted" targetRef="Activity_revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(ok)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_accepted_published" name="accepted" sourceRef="Gateway_accepted" targetRef="Event_published" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_rework">
      <bpmndi:BPMNShape id="StartEvent_received_di" bpmnElement="StartEvent_received">
        <dc:Bounds x="62" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="43" y="153" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_revise_di" bpmnElement="Activity_revise">
        <dc:Bounds x="160" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_check_di" bpmnElement="Activity_check">
        <dc:Bounds x="320" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_accepted_di" bpmnElement="Gateway_accepted" isMarkerVisible="true">
        <dc:Bounds x="485" y="105" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="482" y="160" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_published_di" bpmnElement="Event_published">
        <dc:Bounds x="622" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="614" y="153" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_received_revise_di" bpmnElement="Flow_received_revise">
        <di:waypoint x="98" y="130" />
        <di:waypoint x="160" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_revise_check_di" bpmnElement="Flow_revise_check">
        <di:waypoint x="260" y="130" />
        <di:waypoint x="320" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_check_accepted_di" bpmnElement="Flow_check_accepted">
        <di:waypoint x="420" y="130" />
        <di:waypoint x="485" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_accepted_revise_di" bpmnElement="Flow_accepted_revise">
        <di:waypoint x="510" y="105" />
        <di:waypoint x="510" y="60" />
        <di:waypoint x="210" y="60" />
        <di:waypoint x="210" y="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="540" y="41" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_accepted_published_di" bpmnElement="Flow_accepted_published">
        <di:waypoint x="535" y="130" />
        <di:waypoint x="622" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="540" y="111" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
