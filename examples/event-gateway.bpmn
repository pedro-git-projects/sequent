<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="sequent" exporterVersion="0.2.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:message id="Message_cancelled" name="order-cancelled">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_shipped" name="shipment-dispatched">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="Process_await_outcome" name="Await the outcome" isExecutable="true">
    <bpmn:startEvent id="StartEvent_placed" name="Order placed">
      <bpmn:outgoing>Flow_placed_outcome</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="Gateway_outcome" name="First to arrive">
      <bpmn:incoming>Flow_placed_outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_outcome_got_shipment</bpmn:outgoing>
      <bpmn:outgoing>Flow_outcome_got_cancel</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Activity_got_shipment" name="Shipment notice" messageRef="Message_shipped">
      <bpmn:incoming>Flow_outcome_got_shipment</bpmn:incoming>
      <bpmn:outgoing>Flow_got_shipment_confirm</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Activity_confirm" name="Confirm to the customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_got_shipment_confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_outcome_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Activity_got_cancel" name="Cancellation" messageRef="Message_cancelled">
      <bpmn:incoming>Flow_outcome_got_cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_got_cancel_refund</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Activity_refund" name="Refund">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment-refund" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_got_cancel_refund</bpmn:incoming>
      <bpmn:outgoing>Flow_refund_outcome_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_outcome_join">
      <bpmn:incoming>Flow_confirm_outcome_join</bpmn:incoming>
      <bpmn:incoming>Flow_refund_outcome_join</bpmn:incoming>
      <bpmn:outgoing>Flow_outcome_join_closed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_closed" name="Closed">
      <bpmn:incoming>Flow_outcome_join_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_placed_outcome" sourceRef="StartEvent_placed" targetRef="Gateway_outcome" />
    <bpmn:sequenceFlow id="Flow_outcome_got_shipment" sourceRef="Gateway_outcome" targetRef="Activity_got_shipment" />
    <bpmn:sequenceFlow id="Flow_got_shipment_confirm" sourceRef="Activity_got_shipment" targetRef="Activity_confirm" />
    <bpmn:sequenceFlow id="Flow_outcome_got_cancel" sourceRef="Gateway_outcome" targetRef="Activity_got_cancel" />
    <bpmn:sequenceFlow id="Flow_got_cancel_refund" sourceRef="Activity_got_cancel" targetRef="Activity_refund" />
    <bpmn:sequenceFlow id="Flow_confirm_outcome_join" sourceRef="Activity_confirm" targetRef="Gateway_outcome_join" />
    <bpmn:sequenceFlow id="Flow_refund_outcome_join" sourceRef="Activity_refund" targetRef="Gateway_outcome_join" />
    <bpmn:sequenceFlow id="Flow_outcome_join_closed" sourceRef="Gateway_outcome_join" targetRef="Event_closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_await_outcome">
      <bpmndi:BPMNShape id="StartEvent_placed_di" bpmnElement="StartEvent_placed">
        <dc:Bounds x="62" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="46" y="173" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_outcome_di" bpmnElement="Gateway_outcome">
        <dc:Bounds x="145" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="90" y="106" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_got_shipment_di" bpmnElement="Activity_got_shipment">
        <dc:Bounds x="280" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_confirm_di" bpmnElement="Activity_confirm">
        <dc:Bounds x="440" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_got_cancel_di" bpmnElement="Activity_got_cancel">
        <dc:Bounds x="280" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_refund_di" bpmnElement="Activity_refund">
        <dc:Bounds x="440" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_outcome_join_di" bpmnElement="Gateway_outcome_join" isMarkerVisible="true">
        <dc:Bounds x="605" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_closed_di" bpmnElement="Event_closed">
        <dc:Bounds x="702" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="702" y="173" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_placed_outcome_di" bpmnElement="Flow_placed_outcome">
        <di:waypoint x="98" y="150" />
        <di:waypoint x="145" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_outcome_got_shipment_di" bpmnElement="Flow_outcome_got_shipment">
        <di:waypoint x="170" y="125" />
        <di:waypoint x="170" y="80" />
        <di:waypoint x="280" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_got_shipment_confirm_di" bpmnElement="Flow_got_shipment_confirm">
        <di:waypoint x="380" y="80" />
        <di:waypoint x="440" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_outcome_got_cancel_di" bpmnElement="Flow_outcome_got_cancel">
        <di:waypoint x="170" y="175" />
        <di:waypoint x="170" y="220" />
        <di:waypoint x="280" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_got_cancel_refund_di" bpmnElement="Flow_got_cancel_refund">
        <di:waypoint x="380" y="220" />
        <di:waypoint x="440" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_confirm_outcome_join_di" bpmnElement="Flow_confirm_outcome_join">
        <di:waypoint x="540" y="80" />
        <di:waypoint x="630" y="80" />
        <di:waypoint x="630" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_refund_outcome_join_di" bpmnElement="Flow_refund_outcome_join">
        <di:waypoint x="540" y="220" />
        <di:waypoint x="630" y="220" />
        <di:waypoint x="630" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_outcome_join_closed_di" bpmnElement="Flow_outcome_join_closed">
        <di:waypoint x="655" y="150" />
        <di:waypoint x="702" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
